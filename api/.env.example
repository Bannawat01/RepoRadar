# ── Server ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── GitHub webhook ─────────────────────────────────────
# Same secret you enter in the GitHub webhook config. Used for HMAC-SHA256 verification.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Discord delivery ───────────────────────────────────
# Server Settings → Integrations → Webhooks → Copy Webhook URL.
# The API builds the rich embed and posts it here directly (no n8n involved).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/xxxxxxxx
# Retry policy for transient 429 rate-limits and 5xx blips.
DISCORD_MAX_TRIES=5
DISCORD_RETRY_MS=3000

# ── CORS (frontend access to GET /logs) ────────────────
# Comma-separated list of allowed origins. Add your deployed frontend + local dev.
CORS_ORIGINS=https://bannawat.site,http://localhost:5173
