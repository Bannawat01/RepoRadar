# ── Server ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── GitHub webhook ─────────────────────────────────────
# Same secret you enter in the GitHub webhook config. Used for HMAC-SHA256 verification.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── n8n forwarding ─────────────────────────────────────
# The n8n Webhook trigger URL the API forwards normalized events to.
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/reporadar
# Shared secret sent as the X-RepoRadar-Token header; n8n verifies it.
N8N_FORWARD_TOKEN=change-me-shared-secret

# ── CORS (frontend access to GET /logs) ────────────────
# Comma-separated list of allowed origins. Add your deployed frontend + local dev.
CORS_ORIGINS=https://bannawat.site,http://localhost:5173

# NOTE: DISCORD_WEBHOOK_URL lives in n8n, not here. The API never talks to Discord.
